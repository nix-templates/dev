{
  "//": "Settings for this environment. Every tool path is a bare binary name so that it resolves through the direnv-provided PATH from the Nix devShell.",
  "direnv.restart.automatic": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.eol": "\n",
  "editor.formatOnSave": true,
  "editor.rulers": [
    100
  ],
  "search.exclude": {
    "**/.direnv": true,
    "**/result": true,
    "**/node_modules": true,
    "**/target": true,
    "**/.venv": true
  },
  "files.watcherExclude": {
    "**/.direnv/**": true,
    "**/result/**": true
  },
  "nix.formatterPath": "nixfmt",
  "ansible.validation.lint.enabled": true,
  "ansible.validation.lint.path": "ansible-lint",
  "ansible.python.interpreterPath": "python3",
  "files.associations": {
    "**/playbooks/*.yml": "ansible",
    "**/tasks/*.yml": "ansible"
  },
  "[ansible]": {
    "editor.defaultFormatter": "redhat.ansible",
    "editor.tabSize": 2
  }
}
